<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#12416f" />
    <title>@(ViewData["Title"] ?? "Sign In") – FRISL EAMS | First Registrars</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth">
        <aside class="auth-brand" aria-label="About FRISL EAMS">
            <div class="auth-brand-top">First Registrars &amp; Investor Services</div>

            <div class="auth-brand-main">
                <span class="auth-eyebrow">FRISL EAMS</span>
                <h1 class="auth-headline">Every asset, <span>accounted for.</span></h1>
                <p class="auth-lede">Track, assign, verify and audit company assets across every office and department, all in one place.</p>

                <ul class="auth-features">
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                        <span><strong>RFID asset tagging</strong>Tag, scan and locate assets in seconds.</span>
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3l4 4-4 4"/><path d="M3 7h18"/><path d="M7 21l-4-4 4-4"/><path d="M21 17H3"/></svg>
                        <span><strong>Assignments &amp; transfers</strong>Know who holds what, and where it moved.</span>
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                        <span><strong>Audit &amp; stock verification</strong>Reconcile the register against what's on the floor.</span>
                    </li>
                </ul>
            </div>

            <div class="auth-brand-foot">Authorised access only. Activity on this system is logged.</div>
        </aside>

        <main class="auth-panel">
            <div class="auth-card">
                <img src="~/firstregistrars-logo.png" alt="First Registrars &amp; Investor Services" class="auth-logo" />
                @RenderBody()
                <p class="auth-foot">&copy; @DateTime.Now.Year First Registrars &amp; Investor Services Ltd. All rights reserved.</p>
            </div>
        </main>
    </div>

    <script>
        (function () {
            var pwd = document.getElementById('password');
            var toggle = document.querySelector('.auth-toggle');
            if (pwd && toggle) {
                toggle.addEventListener('click', function () {
                    var show = pwd.type === 'password';
                    pwd.type = show ? 'text' : 'password';
                    toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
                    toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    pwd.focus();
                });
            }

            var caps = document.getElementById('capsWarning');
            if (pwd && caps) {
                var check = function (e) {
                    if (e.getModifierState) caps.classList.toggle('is-on', e.getModifierState('CapsLock'));
                };
                pwd.addEventListener('keyup', check);
                pwd.addEventListener('keydown', check);
                pwd.addEventListener('blur', function () { caps.classList.remove('is-on'); });
            }

            var form = document.getElementById('loginForm');
            if (form) {
                form.addEventListener('submit', function () {
                    var btn = form.querySelector('.auth-btn');
                    if (btn) { btn.classList.add('is-loading'); btn.setAttribute('aria-busy', 'true'); }
                });
            }

            document.querySelectorAll('.auth-chip').forEach(function (chip) {
                chip.addEventListener('click', function () {
                    document.getElementById('username').value = chip.dataset.user;
                    if (pwd) pwd.value = chip.dataset.password;
                });
            });
        })();
    </script>
</body>
</html>
