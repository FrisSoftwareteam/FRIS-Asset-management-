@{
    ViewData["Title"] = "Admin Dashboard";
    var metrics = ViewBag.Metrics as Dictionary<string, int> ?? new();
    var summary = ViewBag.Summary as FrislEams.Web.Services.AdminDashboardMetrics ?? new();
    var recentUsers = ViewBag.RecentUsers as List<FrislEams.Web.Models.UserAccount> ?? new();
    var recentLogs = ViewBag.RecentLogs as List<FrislEams.Web.Models.SystemAuditLog> ?? new();
    var usersByRole = ViewBag.UsersByRole as Dictionary<string, int> ?? new();
    var activity = ViewBag.UserActivity as int[] ?? new int[7];
    var activityDays = ViewBag.ActivityDays as DateTime[]
        ?? Enumerable.Range(0, 7).Select(i => DateTime.UtcNow.Date.AddDays(i - 6)).ToArray();
    var maxActivity = Math.Max(1, activity.DefaultIfEmpty(0).Max());
    var totalActivity = activity.Sum();

    var displayName = Context.Session.GetString("UserName") ?? "Admin";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

    var totalUsers = metrics.GetValueOrDefault("Total Users");
    var activeUsers = metrics.GetValueOrDefault("Active Users");
    var rfidTags = metrics.GetValueOrDefault("RFID Devices");
    var pendingTotal = summary.PendingRepairRequests + summary.PendingAssetRequests
                       + summary.PendingLoanRequests + summary.PendingAssignmentConfirmations;

    // Group the detailed statuses into a handful of buckets for the status bar.
    var byStatus = summary.AssetsByStatus;
    int Sum(params AssetStatus[] s) => s.Sum(x => byStatus.GetValueOrDefault(x.ToString()));
    var statusBuckets = new (string Label, int Count, string Css)[]
    {
        ("In use", Sum(AssetStatus.ActiveAssigned, AssetStatus.AssignedPendingConfirmation), "s-use"),
        ("Available", Sum(AssetStatus.RegisteredUnassigned, AssetStatus.UnregisteredUnassigned, AssetStatus.RecalledToStorage), "s-free"),
        ("On loan", Sum(AssetStatus.LoanedOutInternal, AssetStatus.LoanedOutExternal), "s-loan"),
        ("Repair / damaged", Sum(AssetStatus.UnderRepair, AssetStatus.Damaged, AssetStatus.PendingReplacement), "s-repair"),
        ("Procurement", Sum(AssetStatus.UnderProcurement), "s-proc"),
        ("Retired", Sum(AssetStatus.Retired, AssetStatus.Sold, AssetStatus.Discarded), "s-retired"),
    };
    var statusTotal = Math.Max(1, statusBuckets.Sum(b => b.Count));

    var attention = new (string Label, int Count, string Href, string Tone)[]
    {
        ("Repair requests awaiting review", summary.PendingRepairRequests, "/Workflow/Repairs", "warn"),
        ("Asset requests pending", summary.PendingAssetRequests, "/Workflow/Requests", "warn"),
        ("Loan requests pending", summary.PendingLoanRequests, "/Workflow/Loans", "warn"),
        ("Assignments awaiting receipt", summary.PendingAssignmentConfirmations, "/Assignments", "info"),
        ("RFID exit alerts", summary.ExitAlerts, "/Exceptions", "danger"),
        ("Warranties expiring in 90 days", summary.WarrantyExpiringSoon, "/Assets", "info"),
    };
    var openItems = attention.Where(a => a.Count > 0).ToList();
    var maxRole = Math.Max(1, usersByRole.Values.DefaultIfEmpty(0).Max());

    static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours} h ago";
        if (span.TotalDays < 2) return "yesterday";
        return $"{(int)span.TotalDays} days ago";
    }

    static string Initials(string name)
    {
        var parts = (name ?? "").Split(new[] { ' ', '.', '_', '@' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}

<div class="dash">
    <section class="dash-hero">
        <div>
            <p class="dash-eyebrow">Admin Portal · @DateTime.Now.ToString("dddd d MMMM")</p>
            <h1 class="dash-title">@greeting, @displayName</h1>
            <p class="dash-sub">
                @if (pendingTotal > 0)
                {
                    <span>You have <strong>@pendingTotal</strong> item@(pendingTotal == 1 ? "" : "s") waiting for a decision.</span>
                }
                else
                {
                    <span>Nothing is waiting for you. Everything is up to date.</span>
                }
            </p>
        </div>
        <div class="dash-actions">
            <a class="dash-btn dash-btn-primary" href="/Users/Create">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
                Add user
            </a>
            <a class="dash-btn" href="/Assets/Register">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                Register asset
            </a>
            <a class="dash-btn" href="/AuditTrails">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
                Audit logs
            </a>
        </div>
    </section>

    <section class="dash-kpis" aria-label="Key figures">
        <a class="dash-kpi" href="/Users">
            <span class="dash-kpi-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
            <span class="dash-kpi-label">Users</span>
            <span class="dash-kpi-value">@totalUsers.ToString("N0")</span>
            <span class="dash-kpi-meta">@activeUsers active · @(totalUsers - activeUsers) disabled</span>
        </a>
        <a class="dash-kpi" href="/Assets">
            <span class="dash-kpi-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12"/></svg></span>
            <span class="dash-kpi-label">Assets</span>
            <span class="dash-kpi-value">@summary.TotalAssets.ToString("N0")</span>
            <span class="dash-kpi-meta">@summary.ActiveAssigned in use · @summary.RegisteredUnassigned available</span>
        </a>
        <a class="dash-kpi @(pendingTotal > 0 ? "is-alert" : "")" href="/Workflow/Requests">
            <span class="dash-kpi-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
            <span class="dash-kpi-label">Pending approvals</span>
            <span class="dash-kpi-value">@pendingTotal.ToString("N0")</span>
            <span class="dash-kpi-meta">Requests, repairs, loans and receipts</span>
        </a>
        <a class="dash-kpi" href="/RfidTags">
            <span class="dash-kpi-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1"/></svg></span>
            <span class="dash-kpi-label">RFID tags</span>
            <span class="dash-kpi-value">@rfidTags.ToString("N0")</span>
            <span class="dash-kpi-meta">@summary.ExitAlerts exit alert@(summary.ExitAlerts == 1 ? "" : "s") logged</span>
        </a>
    </section>

    <section class="dash-grid dash-grid-wide">
        <article class="dash-card">
            <header class="dash-card-head">
                <div>
                    <h2>System activity</h2>
                    <p>Actions recorded in the audit log, last 7 days</p>
                </div>
                <span class="dash-pill">@totalActivity.ToString("N0") total</span>
            </header>
            @if (totalActivity == 0)
            {
                <div class="dash-empty">No activity has been recorded in the last 7 days.</div>
            }
            else
            {
                <div class="dash-bars" role="img" aria-label="Audit log actions per day for the last 7 days">
                    @for (var i = 0; i < activity.Length; i++)
                    {
                        var h = (int)Math.Round(activity[i] * 100.0 / maxActivity);
                        var isToday = i == activity.Length - 1;
                        <div class="dash-bar-col @(isToday ? "is-today" : "")" title="@activityDays[i].ToString("ddd d MMM"): @activity[i]">
                            <span class="dash-bar-num">@activity[i]</span>
                            <div class="dash-bar-track"><div class="dash-bar" style="height:@(Math.Max(h, activity[i] > 0 ? 4 : 0))%"></div></div>
                            <span class="dash-bar-day">@(isToday ? "Today" : activityDays[i].ToString("ddd"))</span>
                        </div>
                    }
                </div>
            }
        </article>

        <article class="dash-card">
            <header class="dash-card-head">
                <div>
                    <h2>Needs attention</h2>
                    <p>Open items across the system</p>
                </div>
            </header>
            @if (!openItems.Any())
            {
                <div class="dash-empty dash-empty-ok">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                    All clear. Nothing needs your attention.
                </div>
            }
            else
            {
                <ul class="dash-list">
                    @foreach (var item in openItems)
                    {
                        <li>
                            <a class="dash-attn" href="@item.Href">
                                <span class="dash-dot tone-@item.Tone" aria-hidden="true"></span>
                                <span class="dash-attn-label">@item.Label</span>
                                <span class="dash-count tone-@item.Tone">@item.Count</span>
                                <svg class="dash-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                            </a>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>

    <section class="dash-grid">
        <article class="dash-card">
            <header class="dash-card-head">
                <div>
                    <h2>Assets by status</h2>
                    <p>@summary.TotalAssets.ToString("N0") assets in the register</p>
                </div>
                <a class="dash-link" href="/Assets">View register</a>
            </header>
            @if (summary.TotalAssets == 0)
            {
                <div class="dash-empty">No assets registered yet. <a class="dash-link" href="/Assets/Register">Register the first one</a>.</div>
            }
            else
            {
                <div class="dash-stack" role="img" aria-label="Share of assets by status">
                    @foreach (var b in statusBuckets.Where(b => b.Count > 0))
                    {
                        <span class="dash-stack-seg @b.Css" style="width:@((b.Count * 100.0 / statusTotal).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%" title="@b.Label: @b.Count"></span>
                    }
                </div>
                <ul class="dash-legend">
                    @foreach (var b in statusBuckets)
                    {
                        <li class="@(b.Count == 0 ? "is-zero" : "")">
                            <span class="dash-swatch @b.Css" aria-hidden="true"></span>
                            <span>@b.Label</span>
                            <strong>@b.Count.ToString("N0")</strong>
                        </li>
                    }
                </ul>
            }
        </article>

        <article class="dash-card">
            <header class="dash-card-head">
                <div>
                    <h2>Users by role</h2>
                    <p>@usersByRole.Count role@(usersByRole.Count == 1 ? "" : "s") in use</p>
                </div>
                <a class="dash-link" href="/UserRoles">Manage roles</a>
            </header>
            @if (!usersByRole.Any())
            {
                <div class="dash-empty">No user accounts yet.</div>
            }
            else
            {
                <ul class="dash-hbars">
                    @foreach (var r in usersByRole)
                    {
                        <li>
                            <span class="dash-hbar-label">@r.Key</span>
                            <span class="dash-hbar-track"><span class="dash-hbar" style="width:@((r.Value * 100.0 / maxRole).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                            <strong>@r.Value</strong>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>

    <section class="dash-grid dash-grid-wide">
        <article class="dash-card">
            <header class="dash-card-head">
                <div>
                    <h2>Recent activity</h2>
                    <p>Latest entries in the audit log</p>
                </div>
                <a class="dash-link" href="/AuditTrails">See all</a>
            </header>
            @if (!recentLogs.Any())
            {
                <div class="dash-empty">No audit entries yet.</div>
            }
            else
            {
                <ul class="dash-feed">
                    @foreach (var log in recentLogs)
                    {
                        <li>
                            <span class="dash-avatar" aria-hidden="true">@Initials(log.Username)</span>
                            <div class="dash-feed-body">
                                <div><strong>@(string.IsNullOrWhiteSpace(log.Username) ? "System" : log.Username)</strong> @log.Action
                                    @if (!string.IsNullOrWhiteSpace(log.EntityType))
                                    {
                                        <span class="dash-tag">@log.EntityType@(string.IsNullOrWhiteSpace(log.EntityId) ? "" : $" #{log.EntityId}")</span>
                                    }
                                </div>
                                <time datetime="@log.OccurredAt.ToString("o")">@Ago(log.OccurredAt)</time>
                            </div>
                        </li>
                    }
                </ul>
            }
        </article>

        <article class="dash-card">
            <header class="dash-card-head">
                <div>
                    <h2>Newest accounts</h2>
                    <p>Most recently created users</p>
                </div>
                <a class="dash-link" href="/Users">All users</a>
            </header>
            @if (!recentUsers.Any())
            {
                <div class="dash-empty">No user accounts yet.</div>
            }
            else
            {
                <ul class="dash-feed">
                    @foreach (var user in recentUsers)
                    {
                        var name = string.IsNullOrWhiteSpace(user.DisplayName) ? user.Username : user.DisplayName;
                        <li>
                            <span class="dash-avatar" aria-hidden="true">@Initials(name)</span>
                            <div class="dash-feed-body">
                                <div><strong>@name</strong> <span class="dash-tag">@user.Role</span>
                                    @if (!user.IsActive)
                                    {
                                        <span class="dash-tag dash-tag-off">Disabled</span>
                                    }
                                </div>
                                <time datetime="@user.CreatedAt.ToString("o")">@user.Username · joined @Ago(user.CreatedAt)</time>
                            </div>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>
</div>
