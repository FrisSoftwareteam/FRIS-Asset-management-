@{
    Layout = "_LoginLayout";
    var portal = ViewBag.Portal as string ?? "Backoffice";
    var demoUser = ViewBag.DemoUser as string ?? portal;
    var returnUrl = ViewBag.ReturnUrl as string;
    ViewData["Title"] = $"{portal} Portal Sign In";

    var portalDesc = portal switch
    {
        "Admin" => "System administration, user management, vendors and approvals.",
        "Auditor" => "Audits, compliance verification and asset reporting.",
        "Staff" => "Your assigned assets, requests, repairs and loans.",
        _ => "Asset administration, operations and master data management."
    };

    ViewData["FormAction"] = string.IsNullOrEmpty(returnUrl)
        ? $"/Account/Login/{portal}"
        : $"/Account/Login/{portal}?returnUrl={Uri.EscapeDataString(returnUrl)}";
    ViewData["ButtonText"] = $"Sign in to {portal} Portal";
    ViewData["UserPlaceholder"] = $"Enter your {portal.ToLowerInvariant()} username";
    ViewData["DemoUsers"] = portal == "Staff"
        ? new (string Label, string User, string Password)[] { ("Staff", "Staff", "Staff1"), ("IT HOD", "ithod", "HodIt1") }
        : new (string Label, string User, string Password)[]
          {
              (demoUser, demoUser, portal == "Auditor" ? "auditor1" : portal == "Admin" ? "Admin1" : "Washington1")
          };

    var backHref = string.IsNullOrEmpty(returnUrl)
        ? "/Account/Login"
        : $"/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
}

<span class="auth-portal-tag">@portal Portal</span>
<h2 class="auth-title">Sign in</h2>
<p class="auth-desc">@portalDesc</p>

<partial name="_LoginForm" />

<p class="auth-help"><a class="auth-link" href="@backHref">← Back to main sign in</a></p>
