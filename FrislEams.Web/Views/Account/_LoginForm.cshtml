@using Microsoft.Extensions.Hosting
@inject IWebHostEnvironment Env
@{
    var action = ViewData["FormAction"] as string ?? "/Account/Login";
    var buttonText = ViewData["ButtonText"] as string ?? "Sign in";
    var userPlaceholder = ViewData["UserPlaceholder"] as string ?? "Enter your username";
    var demoUsers = ViewData["DemoUsers"] as (string Label, string User, string Password)[] ?? Array.Empty<(string, string, string)>();
}

@if (ViewBag.Error != null)
{
    <div class="auth-alert" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        <span>@ViewBag.Error</span>
    </div>
}

<form method="post" action="@action" class="auth-form" id="loginForm" novalidate>
    @Html.AntiForgeryToken()

    <div class="auth-field">
        <label for="username">Username</label>
        <div class="auth-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <input type="text" id="username" name="username" class="auth-input" placeholder="@userPlaceholder"
                   autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required />
        </div>
    </div>

    <div class="auth-field">
        <label for="password">Password</label>
        <div class="auth-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" id="password" name="password" class="auth-input" placeholder="Enter your password"
                   autocomplete="current-password" required />
            <button type="button" class="auth-toggle" aria-label="Show password" aria-pressed="false">
                <svg class="icon-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="icon-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
            </button>
        </div>
        <div class="auth-caps" id="capsWarning" role="status">Caps Lock is on</div>
    </div>

    <button type="submit" class="auth-btn">
        <span>@buttonText</span>
        <span class="auth-spinner" aria-hidden="true"></span>
        <svg class="auth-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
    </button>
</form>

<p class="auth-help">Trouble signing in? Contact the IT department.</p>

@* Demo quick-fill is shown only when running in Development, so live passwords are never printed on the public page. *@
@if (Env.IsDevelopment() && demoUsers.Length > 0)
{
    <div class="auth-demo">
        <p class="auth-demo-head">Demo accounts · click to fill</p>
        <div class="auth-demo-grid">
            @foreach (var d in demoUsers)
            {
                <button type="button" class="auth-chip" data-user="@d.User" data-password="@d.Password">@d.Label</button>
            }
        </div>
    </div>
}
