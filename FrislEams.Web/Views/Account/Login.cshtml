@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewBag.ReturnUrl as string;

    ViewData["FormAction"] = string.IsNullOrEmpty(returnUrl)
        ? "/Account/Login"
        : $"/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    ViewData["ButtonText"] = "Sign in";
    ViewData["DemoUsers"] = new (string Label, string User, string Password)[]
    {
        ("Backoffice", "Washington", "Washington1"),
        ("Admin", "Admin", "Admin1"),
        ("Auditor", "Auditor", "auditor1"),
        ("Staff", "Staff", "Staff1")
    };
}

<h2 class="auth-title">Welcome back</h2>
<p class="auth-desc">Sign in to the Enterprise Asset Management System. You'll be taken to your portal automatically.</p>

<partial name="_LoginForm" />
